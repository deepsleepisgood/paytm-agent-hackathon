# Template for the root .env. Copy it to .env and fill in SARVAM_API_KEY. Never commit .env.
# For Railway and Vercel, see deploy/README.md.
#
# Who reads this file:
#   8001 sarvam_service and 8002 paytm_agent - load_dotenv() searches up from app/config.py to this file
#   8003 merchant_agent - reads services/merchant_agent/.env first, then this file
#   3000 frontend - Vite does NOT read this file; src/config.js already defaults to the localhost URLs below
# A per-service .env, if one exists, wins over this file for that service.

# ---------- 8001 sarvam_service (Person 1) ----------
SARVAM_API_KEY=
# auto = live because a key is set; use mock to save credits while rehearsing
SARVAM_MODE=auto
# true for demos: a Sarvam hiccup returns a mock answer labelled source="mock"
SARVAM_FALLBACK_TO_MOCK=true
# Sarvam TTS needs 4-8 s for a full reply (measured). The default 5 s budget made half the replies
# fall back to the mock tone (the app beeped instead of speaking). 8003 waits up to TTS_TIMEOUT_S=15.
SARVAM_LATENCY_BUDGET=12
# Also read by 8002 when ALLOWED_ORIGINS is unset
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------- 8002 paytm_agent (Person 2) ----------
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SEED_MID=PAYTM_MERCH_8821

# ---------- 8003 merchant_agent (Person 3) ----------
# 127.0.0.1, not localhost: on Windows, localhost tries IPv6 first and adds ~2s per call
SARVAM_SERVICE_URL=http://127.0.0.1:8001
PAYTM_AGENT_URL=http://127.0.0.1:8002
UPSTREAM_TIMEOUT_S=6
DOC_EXTRACT_TIMEOUT_S=30
UPSTREAM_CIRCUIT_COOLDOWN_S=10
# Extra browser origins (localhost:3000 is built in)
CORS_EXTRA_ORIGINS=
# Leave empty: defaults to <repo>/data/seed
DATASET_DIR=
UTTERANCE_FAST_PATH=1
# 1 = Sarvam LLM answers the actual question (numbers checked against the data). 0 = fixed templates only.
REPLY_LLM=1

# ---------- Supabase (optional persistence + Realtime; see supabase/README.md) ----------
# Backends: false = in-memory only. true needs the role passwords (supabase/README.md step 1).
USE_SUPABASE=false
# PAYTM_DB_URL=postgresql://paytm_svc.ijitntwpnqwkjrboweky:<paytm_svc-password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# MERCHANT_DB_URL=postgresql://merchant_svc.ijitntwpnqwkjrboweky:<merchant_svc-password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# Frontend: public read-only anon/publishable key (Dashboard -> Project Settings -> API). Vite reads frontend/.env.
VITE_SUPABASE_URL=https://ijitntwpnqwkjrboweky.supabase.co
VITE_SUPABASE_ANON_KEY=

# ---------- 3000 frontend (Person 4) - reference only ----------
# Vite reads only frontend/.env*. These equal the defaults in frontend/src/config.js.
# On Vercel, set them as project env vars pointing at the Railway URLs.
# VITE_SARVAM_URL=http://localhost:8001
# VITE_PAYTM_URL=http://localhost:8002
# VITE_MERCHANT_URL=http://localhost:8003
# VITE_MID=PAYTM_MERCH_8821
