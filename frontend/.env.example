# Sarvam Voice Agent (Sales discovery). Copy to .env.local (never commit it).
# Secret, stays server-side (vite dev proxy / proxy/sarvam-proxy.mjs):
SARVAM_API_KEY=
# Not secret, from the agent's page in the Sarvam dashboard (Deploy with Code):
VITE_SARVAM_ORG_ID=
VITE_SARVAM_WORKSPACE_ID=
VITE_SARVAM_APP_ID=
# Only when the proxy is deployed somewhere else, e.g. https://your-proxy.onrender.com/api/sarvam/
# VITE_SARVAM_PROXY=
