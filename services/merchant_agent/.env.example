# Copy to .env (git-ignored). Names match PLAN.md.
SARVAM_SERVICE_URL=http://127.0.0.1:8001
PAYTM_AGENT_URL=http://127.0.0.1:8002
UPSTREAM_TIMEOUT_S=6
# Sarvam Vision can take up to 25 s (Person 1's SARVAM_DOC_LATENCY_BUDGET); wait a bit longer than that
DOC_EXTRACT_TIMEOUT_S=30
UPSTREAM_CIRCUIT_COOLDOWN_S=10
# Comma-separated extra frontend origins (ngrok / Vercel) for field testing
CORS_EXTRA_ORIGINS=
# Team dataset folder; default is <repo root>/dataset. Relative paths are resolved from this folder.
DATASET_DIR=
# 1 = exact matches with dataset utterances (preset chips) skip the LLM; 0 = always ask the LLM first
UTTERANCE_FAST_PATH=1

# --- Supabase (optional; see supabase/README.md) ---------------------------------------
# false = in-memory only (default). true = mirror events/ITC/strategy into the `merchant` schema.
USE_SUPABASE=false
# Connects as merchant_svc, which can only touch the `merchant` schema. Never commit the real value.
MERCHANT_DB_URL=postgresql://merchant_svc.ijitntwpnqwkjrboweky:<merchant_svc-password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
