# Copy to .env and adjust. Never commit .env.

# Port this service binds. The deploy host usually injects its own PORT.
PORT=8002

# Comma-separated origins allowed to call this API from a browser.
# The employee console is served by this same app, so it needs no entry here.
# This list is for Person 4's merchant screen on :3000 and the deployed frontend.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# The seeded demo merchant. Any other mid returns UNKNOWN_MID.
SEED_MID=PAYTM_MERCH_8821

# --- Supabase (optional; see supabase/README.md) ---------------------------------------
# false = in-memory only (default). true = mirror every state change into the `paytm` schema;
# if Supabase is unreachable the service logs one line and carries on in memory.
USE_SUPABASE=false
# Connects as paytm_svc, which can only touch the `paytm` schema. Never commit the real value.
PAYTM_DB_URL=postgresql://paytm_svc.ijitntwpnqwkjrboweky:<paytm_svc-password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
