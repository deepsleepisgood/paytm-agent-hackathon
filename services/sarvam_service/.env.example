# Copy to .env and fill in. Never commit .env.
SARVAM_API_KEY=

# auto = live if a key is set, otherwise mock | live | mock
SARVAM_MODE=auto
# true for the demo (Sarvam hiccup -> mock answer, labelled source="mock");
# false while debugging so real errors surface as HTTP 502
SARVAM_FALLBACK_TO_MOCK=true

# Models: change here if Sarvam renames or you want to try newer ones
SARVAM_STT_MODEL=saaras:v3          # saaras:v4 is newer, try it if your key has access
SARVAM_STT_MODE=transcribe          # or codemix (keeps English words in Latin script: good for Hinglish)
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=priya
SARVAM_LLM_MODEL=sarvam-105b        # sarvam-105b-conversations = faster, no reasoning
SARVAM_LLM_REASONING_EFFORT=none    # none (fastest) | low | medium | high

# Answer within these many seconds or fall back to mock (callers use a 6 s timeout)
SARVAM_LATENCY_BUDGET=5.0
SARVAM_DOC_LATENCY_BUDGET=25

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
