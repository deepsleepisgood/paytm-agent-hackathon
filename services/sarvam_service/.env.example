# Copy to .env and fill in. Never commit .env.
SARVAM_API_KEY=

# auto = live if a key is set, otherwise mock | live | mock   (MOCK_MODE=true also forces mock)
SARVAM_MODE=auto
# true for the demo (Sarvam hiccup -> mock answer, labelled source="mock");
# false while debugging so real errors surface as HTTP 502/504
SARVAM_FALLBACK_TO_MOCK=true

# Models (plan.md V2). Leave these commented out to use the defaults shown.
# SARVAM_STT_MODEL=saaras:v3
# SARVAM_STT_MODE=codemix            # or transcribe (pure Devanagari)
# SARVAM_TTS_MODEL=bulbul:v3         # v4-flash exists, but its default voice is ad-style
# SARVAM_TTS_SPEAKER=priya           # chosen by ear; others: ritu simran kavya neha shubh aditya rahul
# SARVAM_TTS_FALLBACK_MODEL=bulbul:v3
# SARVAM_TTS_FALLBACK_SPEAKER=priya
# SARVAM_LLM_MODEL=sarvam-105b       # sarvam-105b-conversations = faster, no reasoning
# SARVAM_LLM_REASONING_EFFORT=none   # keep none: in live testing "low" returned JSON without the requested fields

# Answer within these many seconds or fall back to mock (callers use a 6 s timeout)
# SARVAM_LATENCY_BUDGET=5.0
# SARVAM_DOC_LATENCY_BUDGET=25

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
